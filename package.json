{
  "name": "thursday-office-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "start": "bun server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "bun test server/index.test.ts",
    "db:migrate": "bun server/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:connections": "bun deploy/test-connection-budget.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.90.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "8.3.5"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
  },
  "license": "MIT"
}
