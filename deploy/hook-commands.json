[
  [
    "compose",
    [
      "exec",
      "-T",
      "web",
      "bun",
      "-e",
      "const r=await fetch('http://127.0.0.1:3000/'); if(!r.ok || !(await r.text()).includes('Thursday Office Vibes')) process.exit(1)"
    ],
    "ghcr.io/kylescudder/thursday-office-tracker@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  ],
  [
    "compose",
    ["exec", "-T", "web", "bun", "deploy/verify.ts"],
    "ghcr.io/kylescudder/thursday-office-tracker@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  ],
  ["backup_database", "office_tracker"],
  [
    "run",
    [
      "docker",
      "run",
      "--rm",
      "--read-only",
      "--cap-drop",
      "ALL",
      "--security-opt",
      "no-new-privileges:true",
      "--user",
      "501:20",
      "--network",
      "platform-db",
      "--memory",
      "128m",
      "--cpus",
      "0.5",
      "--mount",
      "type=bind,src={PLATFORM}/projects/office_tracker/owner-password,dst=/run/secrets/database_password,readonly",
      "--env",
      "DATABASE_URL=postgres://office_tracker_owner@postgres:5432/office_tracker",
      "--env",
      "DATABASE_PASSWORD_FILE=/run/secrets/database_password",
      "ghcr.io/kylescudder/thursday-office-tracker@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "bun",
      "server/migrate.ts"
    ],
    null
  ]
]
